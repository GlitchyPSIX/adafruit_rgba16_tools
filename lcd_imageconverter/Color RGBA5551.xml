<?xml version="1.0" encoding="utf-8"?>
<preset>
  <name>Color RGBA5551</name>
  <prepare>
    <convType>3</convType>
    <monoType>1</monoType>
    <edge>128</edge>
    <scanMain>0</scanMain>
    <scanSub>0</scanSub>
    <inverse>0</inverse>
    <bandScanning>0</bandScanning>
    <bandWidth>1</bandWidth>
    <useCustomScript>0</useCustomScript>
    <customScript><![CDATA[]]></customScript>
    <customPreprocessScript><![CDATA[// 'argb' - pixel's data of type uint32

var a = ((argb >> 24) & 0xff) / 255;
var r = ((argb >> 16) & 0xff) / 255.0 * 31;
var g = ((argb >> 8) & 0xff) / 255.0 * 31;
var b = ((argb >> 0) & 0xff) / 255.0 * 31;

// place modified value back to variable 'argb'
argb = (r << 11) | (g << 6) | (b << 1) | a;
]]></customPreprocessScript>
  </prepare>
  <matrix>
    <maskUsed>0000ffff</maskUsed>
    <maskAnd>ffffffff</maskAnd>
    <maskOr>00000000</maskOr>
    <maskFill>0000ffff</maskFill>
    <operations count="4">
      <operation index="0">
        <mask>00000001</mask>
        <shift>0</shift>
        <left>0</left>
      </operation>
      <operation index="1">
        <mask>0000003e</mask>
        <shift>0</shift>
        <left>0</left>
      </operation>
      <operation index="2">
        <mask>000007c0</mask>
        <shift>0</shift>
        <left>0</left>
      </operation>
      <operation index="3">
        <mask>0000f800</mask>
        <shift>0</shift>
        <left>0</left>
      </operation>
    </operations>
  </matrix>
  <reordering>
    <operations count="0"/>
  </reordering>
  <image>
    <bytesOrder>0</bytesOrder>
    <blockSize>1</blockSize>
    <blockDefaultOnes>0</blockDefaultOnes>
    <splitToRows>1</splitToRows>
    <compressionRle>0</compressionRle>
    <compressionRleMinLength>2</compressionRleMinLength>
    <blockPrefix><![CDATA[0x]]></blockPrefix>
    <blockSuffix><![CDATA[empty]]></blockSuffix>
    <blockDelimiter><![CDATA[, ]]></blockDelimiter>
    <previewPrefix><![CDATA[// ]]></previewPrefix>
    <previewSuffix><![CDATA[empty]]></previewSuffix>
    <previewDelimiter><![CDATA[empty]]></previewDelimiter>
    <previewLevels><![CDATA[ 
∙
░
▒
▓
█]]></previewLevels>
  </image>
  <font>
    <bom>0</bom>
    <sortOrder>1</sortOrder>
    <codec>UTF-8</codec>
  </font>
  <templates>
    <images>:/templates/image_convert</images>
    <fonts>:/templates/font_convert</fonts>
  </templates>
</preset>
